# ここをコピーして .env.local を作り、値を入れてください（Vercelでは「Environment Variables」に同じ名前で登録）
# SHEET_ID を空のままにすると「デモモード」（メモリ上の仮データ）で動きます

SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# 秘密鍵は "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" のように \n 入りの1行で
GOOGLE_PRIVATE_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# iPhoneショートカットから送る合言葉（長めのランダムな文字列に）
SHORTCUT_TOKEN=

# 任意：設定するとボードを開くときにパスコードを聞かれます
BOARD_PASSCODE=
